---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { business } from '../config/business';
import { tracking } from '../config/tracking';
import { seo } from '../config/seo';
const { title, description, image = seo.defaultImage, noindex = false, schema = [], type = 'website' } = Astro.props;
const absolute = (path: string) => new URL(path, business.siteUrl).toString();
const canonical = absolute(Astro.url.pathname);
const configured = seo.indexEnabled;
const organization = { '@context': 'https://schema.org', '@type': business.address && business.city ? 'AutomotiveBusiness' : 'Organization', name: business.name, url: business.siteUrl, telephone: `+${business.whatsapp}`, sameAs: [business.instagram], ...(business.logoPath ? { logo: absolute(business.logoPath) } : {}), ...(business.address && business.city ? { address: { '@type': 'PostalAddress', streetAddress: business.address, addressLocality: business.city } } : {}), ...(business.region ? { areaServed: business.region } : {}) };
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: business.name, url: business.siteUrl };
---
<!doctype html><html lang="pt-BR"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#070809" /><meta name="description" content={description} />
  <meta name="robots" content={noindex || !configured ? 'noindex,follow' : 'index,follow'} />
  {configured && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/barlow-condensed-800.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <title>{title}</title>
  <meta property="og:type" content={type} /><meta property="og:locale" content={seo.locale} /><meta property="og:site_name" content={business.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={absolute(image)} />{configured && <meta property="og:url" content={canonical} />}
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={absolute(image)} />
  {tracking.googleVerification && <meta name="google-site-verification" content={tracking.googleVerification} />}{tracking.bingVerification && <meta name="msvalidate.01" content={tracking.bingVerification} />}
  <script type="application/ld+json" set:html={JSON.stringify([organization, website, ...schema])} />
</head><body>
  <a class="skip-link" href="#main">Pular para o conteúdo</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <a class="floating-whatsapp" href={`https://wa.me/${business.whatsapp}`} target="_blank" rel="noopener noreferrer" aria-label="Falar com a Alpha pelo WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .1 5.4.1 12c0 2.1.6 4.2 1.7 6L0 24l6.2-1.6A12 12 0 0 0 12 24h.1C18.7 24 24 18.6 24 12c0-3.2-1.2-6.2-3.5-8.5ZM12.1 22a10 10 0 0 1-5.1-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A10 10 0 1 1 12.1 22Zm5.5-7.5c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.3-.7.1-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.7-1.7-2-.2-.3 0-.5.2-.7l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.8s1.2 3.1 1.4 3.3c.2.2 2.4 3.6 5.8 5 .8.3 1.4.5 1.9.6.8.1 1.5.1 2.1 0 .6-.1 1.8-.8 2-1.6.3-.8.3-1.5.2-1.6-.1-.2-.3-.3-.6-.5Z"/></svg></a>
  <nav class="mobile-bottom" aria-label="Acesso rápido"><a href="/servicos">Serviços</a><a href={`https://wa.me/${business.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp</a><a href="/agendamento">Agendar</a></nav>
  <div id="consent-banner" class="consent-banner" hidden><p>Podemos usar métricas anônimas para melhorar o site. Seu formulário não é enviado a essas ferramentas.</p><div><button id="consent-no" type="button">Recusar</button><button id="consent-yes" type="button">Aceitar métricas</button></div></div>
  <script define:vars={{ ga4: tracking.ga4, gtm: tracking.gtm, metaPixel: tracking.metaPixel }}>
    const params = new URLSearchParams(location.search);
    const utm = Object.fromEntries([...params.entries()].filter(([key]) => /^utm_(source|medium|campaign|content|term)$/.test(key)));
    if (Object.keys(utm).length) sessionStorage.setItem('alpha_utm', JSON.stringify(utm));
    const consent = localStorage.getItem('alpha_analytics_consent');
    const banner = document.getElementById('consent-banner');
    if (!consent && (ga4 || gtm || metaPixel) && banner) banner.hidden = false;
    function loadTracking() {
      if (gtm) { window.dataLayer = window.dataLayer || []; const script = document.createElement('script'); script.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(gtm)}`; script.async = true; document.head.append(script); }
      else if (ga4) { window.dataLayer = window.dataLayer || []; window.gtag = function(...args){window.dataLayer.push(args)}; window.gtag('js', new Date()); window.gtag('config', ga4); const script = document.createElement('script'); script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4)}`; script.async = true; document.head.append(script); }
      if (metaPixel) { window.fbq = function(...args){(window.fbq.queue = window.fbq.queue || []).push(args)}; window.fbq('init', metaPixel); window.fbq('track', 'PageView'); const script = document.createElement('script'); script.src = 'https://connect.facebook.net/en_US/fbevents.js'; script.async = true; document.head.append(script); }
    }
    if (consent === 'yes') loadTracking();
    document.getElementById('consent-yes')?.addEventListener('click', () => { localStorage.setItem('alpha_analytics_consent','yes'); if (banner) banner.hidden = true; loadTracking(); });
    document.getElementById('consent-no')?.addEventListener('click', () => { localStorage.setItem('alpha_analytics_consent','no'); if (banner) banner.hidden = true; });
  </script>
  <script>
    document.querySelectorAll('a[href*="wa.me/"]').forEach(link => link.addEventListener('click', () => { if (localStorage.getItem('alpha_analytics_consent') === 'yes') (window as any).dataLayer?.push({ event: 'whatsapp_click', source: 'site_link' }); }));
    document.querySelectorAll('a[href*="instagram.com/"]').forEach(link => link.addEventListener('click', () => { if (localStorage.getItem('alpha_analytics_consent') === 'yes') (window as any).dataLayer?.push({ event: 'instagram_click' }); }));
  </script>
</body></html>
