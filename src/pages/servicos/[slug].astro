---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import { services } from '../../data/services';
import { business } from '../../config/business';
export function getStaticPaths() { return services.map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const url = new URL(`/servicos/${service.slug}`, business.siteUrl).toString();
const schema = [
  { '@context':'https://schema.org', '@type':'Service', name:service.name, description:service.description, provider:{ '@type':'Organization', name:business.name, telephone:`+${business.whatsapp}` }, url },
  { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem', position:1, name:'Início', item:business.siteUrl },{ '@type':'ListItem', position:2, name:'Serviços', item:new URL('/servicos',business.siteUrl).toString() },{ '@type':'ListItem', position:3, name:service.name, item:url }] }
];
---
<BaseLayout title={service.seoTitle} description={service.seoDescription} image={service.image} schema={schema}>
  <section class="page-hero has-image"><img src={service.image} alt={service.imageAlt} width="1600" height="900" /><div class="container"><nav class="breadcrumbs" aria-label="Caminho"><a href="/">Início</a><span>/</span><a href="/servicos">Serviços</a><span>/</span><span>{service.name}</span></nav><p class="eyebrow">{service.kicker}</p><h1>{service.name}</h1><p>{service.summary}</p><div class="hero-actions"><a class="btn btn-red" href={`/orcamento?servico=${service.slug}`}>SOLICITAR ORÇAMENTO</a><a class="btn btn-outline" href={`/agendamento?servico=${service.slug}`}>AGENDAR SERVIÇO</a></div></div></section>
  <section class="section section-dark"><div class="container split-section"><div class="split-copy"><p class="eyebrow">ENTENDA O SERVIÇO</p><h2>O CUIDADO CERTO COMEÇA COM UMA BOA AVALIAÇÃO.</h2><p>{service.description}</p><p><strong>Para quem é indicado:</strong> {service.indicated}</p><a class="text-link" href={`/orcamento?servico=${service.slug}`}>CONTAR SOBRE MEU VEÍCULO <span aria-hidden="true">↗</span></a></div><div class="split-photo"><img src={service.image} alt={service.imageAlt} loading="lazy" width="800" height="600" /></div></div></section>
  <section class="section section-graphite"><div class="container"><div class="section-heading"><p class="eyebrow">VISÃO COMPLETA</p><h2>O QUE CONSIDERAMOS.</h2></div><div class="info-columns"><div class="info-panel"><h2>Benefícios</h2><ul>{service.benefits.map(benefit => <li>{benefit}</li>)}</ul></div><div class="info-panel"><h2>Como funciona</h2><ol>{service.process.map(step => <li>{step}</li>)}</ol></div><div class="info-panel"><h2>Limitações importantes</h2><p>{service.limitations}</p></div><div class="info-panel"><h2>Cuidados</h2><p>{service.care}</p></div></div></div></section>
  <section class="section section-dark"><div class="container"><div class="section-heading"><p class="eyebrow">ANTES DE SOLICITAR</p><h2>PERGUNTAS SOBRE {service.name.toUpperCase()}.</h2></div><div class="faq-list">{service.faqs.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>
  <CTA service={service.slug} title={`Vamos cuidar de ${service.name.toLowerCase()}?`} text="Descreva o seu veículo e receba orientação diretamente no WhatsApp." />
  <script define:vars={{ slug: service.slug }}>
    if (localStorage.getItem('alpha_analytics_consent') === 'yes') { const data={service:slug}; window.dataLayer?.push({event:'view_service',...data}); window.gtag?.('event','view_service',data); window.fbq?.('trackCustom','view_service',data); }
  </script>
</BaseLayout>
