---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTA from '../components/CTA.astro';
import { services } from '../data/services';
import { faqs } from '../data/faq';
---
<BaseLayout title="Alpha Fumê e Faróis | Proteção e Estética Automotiva" description="Películas automotivas, PPF, para-brisas e faróis com atendimento personalizado. Conheça os serviços da Alpha e solicite orientação pelo WhatsApp.">
  <div class="intro" id="intro" aria-hidden="true"><div class="intro-light left"></div><div class="intro-light right"></div><div class="intro-red"></div><div class="intro-brand">ALPHA<span>//</span></div></div>
  <section class="hero"><img class="hero-image" src="/images/hero.webp" alt="Veículo esportivo escuro com faróis acesos, imagem ilustrativa" width="1600" height="900" fetchpriority="high" /><div class="container"><div class="hero-copy"><p class="eyebrow">ALPHA FUMÊ E FARÓIS · CUIDADO AUTOMOTIVO</p><h1>PROTEÇÃO E ESTÉTICA AUTOMOTIVA <em>EM OUTRO NÍVEL.</em></h1><p class="lead">Especialistas em películas automotivas, proteção de pintura, para-brisas e faróis. Seu veículo merece atenção em cada detalhe.</p><div class="hero-actions"><a class="btn btn-red" href="/orcamento">SOLICITAR ORÇAMENTO</a><a class="btn btn-outline" href="/servicos">CONHECER SERVIÇOS</a></div></div><div class="hero-rail">PROTEÇÃO <span>·</span> ESTÉTICA <span>·</span> ILUMINAÇÃO</div></div><span class="hero-side-label" aria-hidden="true">PRECISÃO EM CADA DETALHE</span><div class="hero-slope"></div></section>
  <div class="diagonal-divider" aria-hidden="true"></div>
  <section class="section section-dark" id="servicos"><div class="container"><div class="section-heading"><p class="eyebrow">O QUE FAZEMOS</p><h2>SOLUÇÕES PARA CADA DETALHE DO SEU VEÍCULO.</h2><p>Do cuidado com os vidros à proteção da pintura e dos faróis. Explore cada serviço e conte o que seu veículo precisa.</p></div><div class="service-grid">{services.map((service, index) => <ServiceCard service={service} index={index} />)}</div><div style="margin-top:38px"><a class="text-link" href="/servicos">VER TODOS OS SERVIÇOS <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section section-graphite"><div class="container split-section"><div class="split-photo"><img src="/images/ppf.webp" alt="Pintura automotiva com reflexos em vermelho, imagem ilustrativa" loading="lazy" width="800" height="600" /></div><div class="split-copy"><p class="eyebrow">O JEITO ALPHA</p><h2>CUIDADO AUTOMOTIVO EM CADA DETALHE.</h2><p>A Alpha Fumê e Faróis oferece soluções voltadas à proteção, estética e conservação automotiva. Trabalhamos com aplicação de películas, proteção de pintura, serviços em para-brisas e faróis, buscando oferecer um atendimento personalizado de acordo com as necessidades de cada veículo.</p><a class="btn btn-outline" href="/sobre">CONHEÇA A ALPHA</a></div></div></section>
  <section class="section section-dark"><div class="container"><div class="section-heading"><p class="eyebrow">DA IDEIA AO ATENDIMENTO</p><h2>SEU PEDIDO, DO SEU JEITO.</h2><p>Descreva o veículo e escolha quantos serviços precisar. O resumo chega pronto ao seu WhatsApp para você conferir e enviar.</p></div><div class="feature-strip"><div class="feature-item"><h3>01 / ESCOLHA</h3><p>Selecione um ou mais serviços em uma única solicitação.</p></div><div class="feature-item"><h3>02 / PERSONALIZE</h3><p>Responda apenas às perguntas relevantes para cada serviço.</p></div><div class="feature-item"><h3>03 / CONVERSE</h3><p>Revise a mensagem e fale diretamente com a Alpha pelo WhatsApp.</p></div></div><div style="margin-top:38px"><a class="btn btn-red" href="/orcamento">MONTAR MEU ORÇAMENTO</a></div></div></section>
  <CTA />
  <section class="section section-dark"><div class="container"><div class="section-heading"><p class="eyebrow">DÚVIDAS FREQUENTES</p><h2>RESPOSTAS DIRETAS.</h2></div><div class="faq-list">{faqs.slice(0,5).map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div><div style="margin-top:38px"><a class="text-link" href="/perguntas-frequentes">VER TODAS AS PERGUNTAS <span aria-hidden="true">↗</span></a></div></div></section>
  <script>
    const intro = document.getElementById('intro');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (intro && !reduced && !sessionStorage.getItem('alpha_intro_seen')) { sessionStorage.setItem('alpha_intro_seen','yes'); intro.classList.add('play'); }
  </script>
</BaseLayout>
