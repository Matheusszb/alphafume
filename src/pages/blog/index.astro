---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('blog')).sort((a,b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---
<BaseLayout title="Blog Automotivo | Alpha Fumê e Faróis" description="Guias sobre películas automotivas, para-brisas, PPF e faróis para ajudar você a cuidar do veículo.">
  <section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Caminho"><a href="/">Início</a><span>/</span><span>Blog</span></nav><p class="eyebrow">CONTEÚDO AUTOMOTIVO</p><h1>CONHECIMENTO PARA ESCOLHER MELHOR.</h1><p>Guias diretos sobre cuidado, proteção e estética do seu veículo.</p></div></section>
  <section class="section section-dark"><div class="container"><div class="service-grid">{articles.map(article => <article class="service-card"><a class="service-card-image" href={`/blog/${article.id}`}><img src={article.data.image} alt="Imagem ilustrativa do artigo" loading="lazy" width="800" height="500"/></a><div class="service-card-body"><div class="card-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('pt-BR')}</time></div><h2 style="font-size:2rem"><a href={`/blog/${article.id}`}>{article.data.title}</a></h2><p>{article.data.description}</p><a class="text-link" href={`/blog/${article.id}`}>LER ARTIGO <span aria-hidden="true">↗</span></a></div></article>)}</div></div></section>
</BaseLayout>
