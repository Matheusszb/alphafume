---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductInquiry from '../../components/products/ProductInquiry';
import { products } from '../../data/products';
import { business } from '../../config/business';
export function getStaticPaths() { return products.filter(product => product.active).map(product => ({ params:{slug:product.slug}, props:{product} })); }
const { product } = Astro.props;
const schema = [{ '@context':'https://schema.org', '@type':'Product', name:product.name, description:product.description, image:new URL(product.image,business.siteUrl).toString(), brand:{'@type':'Brand',name:product.brand} }];
---
<BaseLayout title={product.seoTitle} description={product.seoDescription} image={product.image} schema={schema}>
  <section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Caminho"><a href="/">Início</a><span>/</span><a href="/produtos">Produtos</a><span>/</span><span>{product.name}</span></nav><p class="eyebrow">{product.category}</p><h1>{product.name}</h1><p>{product.summary}</p></div></section><section class="section section-dark"><div class="container split-section"><div class="split-photo"><img src={product.image} alt={product.name} width="800" height="600"/></div><div class="split-copy"><p class="eyebrow">{product.brand}</p><h2>DETALHES DO PRODUTO.</h2><p>{product.description}</p><ul>{product.features.map(feature => <li>{feature}</li>)}</ul>{product.benefits.length>0 && <><h3>Benefícios</h3><ul>{product.benefits.map(benefit => <li>{benefit}</li>)}</ul></>}<ProductInquiry client:load product={product} /></div></div>{products.filter(item => item.active && item.id !== product.id && item.category === product.category).length>0 && <div class="container" style="margin-top:70px"><h2>PRODUTOS RELACIONADOS</h2><div class="filters">{products.filter(item => item.active && item.id !== product.id && item.category === product.category).slice(0,3).map(item => <a class="btn btn-outline" href={`/produtos/${item.slug}`}>{item.name}</a>)}</div></div>}</section>
  <script define:vars={{ id: product.id }}>
    if (localStorage.getItem('alpha_analytics_consent') === 'yes') { const data={product:id}; window.dataLayer?.push({event:'view_product',...data}); window.gtag?.('event','view_product',data); window.fbq?.('trackCustom','view_product',data); }
  </script>
</BaseLayout>
