---
import type { Service } from '../types/content';
const { service, index = 0 } = Astro.props as { service: Service; index?: number };
---
<article class="service-card">
  <a href={`/servicos/${service.slug}`} class="service-card-image" aria-label={`Conheça ${service.name}`}><img src={service.image} alt={service.imageAlt} loading="lazy" width="800" height="500" /><span class="image-overlay"></span></a>
  <div class="service-card-body"><div class="card-meta"><span>{String(index + 1).padStart(2, '0')}</span><span>{service.kicker}</span></div><h3><a href={`/servicos/${service.slug}`}>{service.name}</a></h3><p>{service.summary}</p><div class="service-card-actions"><a class="text-link" href={`/servicos/${service.slug}`}>SAIBA MAIS <span aria-hidden="true">↗</span></a><a class="text-link subtle" href={`/orcamento?servico=${service.slug}`}>SOLICITAR ORÇAMENTO</a></div></div>
</article>
